# BoothMagic — Environment Variables
# Copy this to .env.local for local dev (never commit .env.local to git)

# Database (Prisma + PostgreSQL)
DATABASE_URL=postgresql://booth:yourpassword@localhost:5432/booth

# Auth.js (NextAuth v5)
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Guest file token (short-lived JWT for /g/ page)
FILE_TOKEN_SECRET=another-random-secret

# Gemini AI (server-side only — NEVER expose to browser)
GEMINI_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP (Brevo/Zoho free tier)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags
ENABLE_VIDEO=false
ENABLE_SLIDESHOW=false
